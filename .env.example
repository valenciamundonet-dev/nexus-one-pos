# Nexus One POS - Variables de entorno
# Copie este archivo a .env y ajuste los valores

# Base de datos SQLite (relativo al directorio prisma/)
DATABASE_URL="file:./dev.db"

# Puerto de la aplicacion Next.js
APP_PORT=3000

# Entorno: production o development
NODE_ENV=production

# Secreto JWT (se genera automaticamente si no se configura)
# Agregue una cadena aleatoria larga para que los tokens sobrevivan reinicios
# JWT_SECRET=tu-secreto-aqui
