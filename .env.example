# Nexus One POS - Variables de entorno
# Copie este archivo a .env y ajuste los valores

# Base de datos SQLite (relativo al directorio prisma/)
DATABASE_URL="file:./dev.db"

# Puerto de la aplicacion Next.js
APP_PORT=3000

# Entorno: production o development
NODE_ENV=production

# Secreto JWT (el instalador lo genera automaticamente)
# Si ejecuta manualmente, genere uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=tu-secreto-aqui

# Clave secreta para generacion/validacion de licencias.
# NO cambiar una vez en produccion (invalidaria licencias existentes).
LICENSE_SECRET=NX1-L1C3NC3-S3CR3T-K3Y-2024-PROD
