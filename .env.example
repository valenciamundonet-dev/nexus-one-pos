# ─────────────────────────────────────────────────────────────
# Nexus One POS v2.9.73 — Variables de entorno
#
# Copie este archivo como .env y ajuste los valores segun su entorno.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Base de datos ──────────────────────────────────────────
# Ruta al archivo SQLite. Se usa modo WAL automaticamente.
# Relativa al directorio raiz del proyecto o absoluta.
DATABASE_URL=file:./prisma/dev.db

# ─── Aplicacion ─────────────────────────────────────────────
# Puerto del servidor Next.js
APP_PORT=3000

# Entorno de ejecucion: development | production
NODE_ENV=development

# ─── Autenticacion ──────────────────────────────────────────
# Clave secreta para JWT. CAMBIAR EN PRODUCCION.
# Genere una con: openssl rand -base64 32
JWT_SECRET=cambiar-esta-clave-secreta-en-produccion

# Duracion de sesion en horas
SESSION_HOURS=24

# ─── Agente de impresion ────────────────────────────────────
# Puerto del agente ESC/POS (Windows winspool.drv)
PRINTER_AGENT_PORT=9100

# ─── Respaldos automaticos ──────────────────────────────────
# Habilitar respaldo automatico de la base de datos (true/false)
AUTO_BACKUP_ENABLED=true

# Intervalo de respaldo en minutos
AUTO_BACKUP_INTERVAL_MINUTES=60

# ─── Licencia ───────────────────────────────────────────────
# Ruta al archivo de licencia (dejar vacio para modo demo)
LICENSE_FILE=
