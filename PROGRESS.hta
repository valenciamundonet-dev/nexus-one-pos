<html><head><title>Nexus One POS - Instalando</title>

<style>

*{margin:0;padding:0;box-sizing:border-box;}

body{font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}

.box{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:28px 24px;max-width:480px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,0.4);}

.header{display:flex;align-items:center;gap:12px;margin-bottom:20px;}

.icon{width:40px;height:40px;background:linear-gradient(135deg,#3b82f6,#2563eb);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;font-weight:700;}

.title{font-size:16px;font-weight:700;color:#f1f5f9;}

.sub{font-size:11px;color:#64748b;margin-top:2px;}

.pct-box{background:#334155;border-radius:8px;height:10px;overflow:hidden;margin-bottom:16px;}

.pct-fill{height:100%;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:8px;transition:width 0.5s ease;width:0%;}

.pct-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}

.pct-text{font-size:22px;font-weight:700;color:#3b82f6;}

.step-badge{font-size:11px;color:#94a3b8;background:#334155;padding:3px 10px;border-radius:20px;}

.msg{color:#e2e8f0;font-size:13px;font-weight:600;margin-bottom:6px;min-height:20px;}

.detail{color:#64748b;font-size:11px;min-height:16px;white-space:pre-wrap;word-break:break-all;max-height:50px;overflow-y:auto;line-height:1.4;}

.status-bar{margin-top:16px;padding-top:12px;border-top:1px solid #334155;display:flex;align-items:center;gap:8px;}

.dot{width:8px;height:8px;border-radius:50%;background:#f59e0b;animation:pulse 1.5s infinite;}

.dot.ok{background:#22c55e;animation:none;}

.dot.err{background:#ef4444;animation:none;}

.status-text{font-size:11px;color:#94a3b8;}

@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}

</style>

<script language='VBScript'>

Dim timerID

timerID = setInterval("updateStatus", 400)



Sub updateStatus()

  On Error Resume Next

  Set fso = CreateObject("Scripting.FileSystemObject")

  statusFile = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%TEMP%") & "\mepos_status.txt"

  If Not fso.FileExists(statusFile) Then Exit Sub



  Set f = fso.OpenTextFile(statusFile, 1)

  If Err.Number <> 0 Then Exit Sub

  lineData = f.ReadAll

  f.Close



  parts = Split(lineData, "|")

  If UBound(parts) < 5 Then Exit Sub

  stepN = parts(0): totalN = parts(1): msgTxt = parts(2): detailTxt = parts(3): pctVal = parts(4)

  doneVal = "": errMsg = ""

  If UBound(parts) >= 6 Then doneVal = parts(5)

  If UBound(parts) >= 7 Then errMsg = parts(6)



  document.getElementById("stepBadge").innerText = "Paso " & stepN & " de " & totalN

  document.getElementById("msg").innerText = msgTxt

  document.getElementById("detail").innerText = detailTxt

  document.getElementById("pctFill").style.width = pctVal & "%"

  document.getElementById("pctText").innerText = pctVal & "%"



  If errMsg <> "" Then

    document.getElementById("detail").style.color = "#fca5a5"

    document.getElementById("msg").style.color = "#fca5a5"

  End If



  If doneVal = "OK" Then

    clearInterval timerID

    document.getElementById("msg").innerText = "INSTALACION COMPLETADA"

    document.getElementById("msg").style.color = "#4ade80"

    document.getElementById("pctFill").style.width = "100%"

    document.getElementById("pctFill").style.background = "linear-gradient(90deg,#22c55e,#16a34a)"

    document.getElementById("pctText").innerText = "100%"

    document.getElementById("pctText").style.color = "#4ade80"

    document.getElementById("stepBadge").innerText = "Listo"

    document.getElementById("detail").innerText = "Puede cerrar esta ventana."

    document.getElementById("detail").style.color = "#4ade80"

    document.getElementById("statusDot").className = "dot ok"

    document.getElementById("statusText").innerText = "Completado"

    document.getElementById("statusText").style.color = "#4ade80"

  ElseIf doneVal = "FAIL" Then

    clearInterval timerID

    document.getElementById("msg").innerText = "ERROR"

    document.getElementById("msg").style.color = "#fca5a5"

    document.getElementById("pctFill").style.background = "linear-gradient(90deg,#ef4444,#dc2626)"

    document.getElementById("detail").innerText = errMsg

    document.getElementById("detail").style.color = "#fca5a5"

    document.getElementById("statusDot").className = "dot err"

    document.getElementById("statusText").innerText = "Error"

    document.getElementById("statusText").style.color = "#fca5a5"

  End If

  On Error GoTo 0

End Sub

</script>

</head><body>

<div class="box">

  <div class="header">

    <div class="icon">N</div>

    <div><div class="title">Nexus One POS</div><div class="sub">Instalando v2.9.83</div></div>

  </div>

  <div class="pct-box"><div class="pct-fill" id="pctFill"></div></div>

  <div class="pct-row">

    <span class="pct-text" id="pctText">0%</span>

    <span class="step-badge" id="stepBadge">Iniciando...</span>

  </div>

  <div class="msg" id="msg">Preparando instalacion...</div>

  <div class="detail" id="detail"></div>

  <div class="status-bar">

    <div class="dot" id="statusDot"></div>

    <span class="status-text" id="statusText">Procesando...</span>

  </div>

</div>

</body></html>

