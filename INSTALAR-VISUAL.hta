<html>
<head>
<title>Nexus One POS v2.9.73 — Instalador</title>
<HTA:APPLICATION
  ID="NexusInstaller"
  APPLICATIONNAME="Nexus One POS Installer"
  BORDERSTYLE="normal"
  BORDER="thick"
  CAPTION="yes"
  ICON="shell32.dll,14"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  VERSION="2.9.73"
  WINDOWSTATE="normal"
/>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  height: 100vh;
  overflow: hidden;
}
.container {
  max-width: 640px;
  margin: 0 auto;
  padding: 30px 24px;
}
.header {
  text-align: center;
  margin-bottom: 28px;
}
.header h1 {
  font-size: 22px;
  color: #38bdf8;
  margin-bottom: 6px;
  letter-spacing: 1px;
}
.header .version {
  font-size: 12px;
  color: #64748b;
}
.progress-section {
  background: #1e293b;
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
  border: 1px solid #334155;
}
.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: 13px;
}
.progress-header .step { color: #94a3b8; }
.progress-header .pct { color: #38bdf8; font-weight: bold; }
.progress-track {
  width: 100%;
  height: 24px;
  background: #0f172a;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #334155;
}
.progress-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #0ea5e9, #38bdf8, #7dd3fc);
  border-radius: 12px;
  transition: width 0.4s ease;
}
.log-box {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 14px;
  height: 220px;
  overflow-y: auto;
  font-family: 'Cascadia Code', 'Consolas', monospace;
  font-size: 12px;
  line-height: 1.6;
  margin-bottom: 20px;
}
.log-line { margin: 0; }
.log-line.ok { color: #4ade80; }
.log-line.warn { color: #fbbf24; }
.log-line.error { color: #f87171; }
.log-line.info { color: #94a3b8; }
.log-line.step { color: #38bdf8; font-weight: bold; }
.btn-row {
  display: flex;
  justify-content: center;
  gap: 12px;
}
.btn {
  padding: 10px 32px;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 0.5px;
}
.btn-primary {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: white;
}
.btn-primary:hover { opacity: 0.9; }
.btn-danger {
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: white;
}
.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
.footer {
  text-align: center;
  margin-top: 16px;
  font-size: 11px;
  color: #475569;
}
.success-banner {
  display: none;
  text-align: center;
  padding: 20px;
  background: #065f46;
  border: 1px solid #10b981;
  border-radius: 10px;
  margin-bottom: 16px;
}
.success-banner h2 { color: #4ade80; margin-bottom: 8px; }
.success-banner p { color: #a7f3d0; font-size: 13px; }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>NEXUS ONE POS</h1>
    <div class="version">v2.9.73 — Sistema Punto de Venta — Instalador Limpio</div>
  </div>

  <div class="success-banner" id="successBanner">
    <h2>Instalacion Completada</h2>
    <p>Para iniciar el sistema, ejecute <b>INICIAR-TODO.bat</b><br>
    El sistema abrira en su navegador: http://localhost:3000<br>
    Usuario por defecto: <b>admin / admin</b></p>
  </div>

  <div class="progress-section">
    <div class="progress-header">
      <span class="step" id="stepLabel">Paso 0 / 7</span>
      <span class="pct" id="pctLabel">0%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>

  <div class="log-box" id="logBox"></div>

  <div class="btn-row" id="btnRow">
    <button class="btn btn-danger" id="btnInstall" onclick="startInstall()">Instalar Limpio</button>
    <button class="btn btn-primary" id="btnClose" onclick="window.close()" style="display:none;">Cerrar</button>
  </div>

  <div class="footer">Nexus One POS v2.9.73 — Next.js 15 + Bun + Prisma + SQLite WAL + shadcn/ui</div>
</div>

<script>
var shell, fso, scriptDir, nodePath;
var totalSteps = 7;
var currentStep = 0;

function init() {
  shell = new ActiveXObject("WScript.Shell");
  fso = new ActiveXObject("Scripting.FileSystemObject");
  scriptDir = unescape(document.location.pathname);
  // Quitar el leading / de HTA: /C:/folder → C:\folder
  scriptDir = scriptDir.replace(/^\//, "");
  // Convertir / a \
  scriptDir = scriptDir.replace(/\//g, "\\");
  // Quitar el nombre del archivo HTA para quedar solo con el directorio
  var lastSlash = scriptDir.lastIndexOf("\\");
  if (lastSlash > 0) scriptDir = scriptDir.substring(0, lastSlash);

  log("Nexus One POS v2.9.73 — Instalador Visual", "step");
  log("Directorio: " + scriptDir, "info");

  // Detectar Node.js al iniciar
  nodePath = findNodeJS();
  if (nodePath) {
    var ver = getNodeVersion(nodePath);
    log("Node.js detectado: " + ver + " en " + nodePath, "ok");
    log("Presione 'Instalar Limpio' para comenzar", "info");
  } else {
    log("Node.js NO detectado en PATH.", "warn");
    log("Si lo instaló recientemente, cierre esta ventana,", "warn");
    log("abra una NUEVA y vuelva a ejecutar el HTA.", "warn");
    log("", "info");
    log("Presione 'Instalar Limpio' para intentar con PATH actualizado.", "info");
  }
  log("", "info");
}

// ============================================================
// DETECCION ROBUSTA DE NODE.JS
// Lee PATH del registro + busca rutas tipicas
// ============================================================
function refreshPath() {
  try {
    var env = shell.Environment("Process");
    var currentPath = env("PATH") || "";
    
    // Leer PATH del sistema (HKLM)
    try {
      var sysPath = shell.RegRead("HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\\Path");
      if (sysPath && currentPath.indexOf(sysPath.substring(0, 20)) === -1) {
        currentPath = sysPath + ";" + currentPath;
      }
    } catch(e) {}
    
    // Leer PATH del usuario (HKCU)
    try {
      var usrPath = shell.RegRead("HKCU\\Environment\\Path");
      if (usrPath && currentPath.indexOf(usrPath.substring(0, 20)) === -1) {
        currentPath = usrPath + ";" + currentPath;
      }
    } catch(e) {}
    
    env("PATH") = currentPath;
    return true;
  } catch(e) {
    return false;
  }
}

function findNodeJS() {
  // 1. Refrescar PATH desde el registro
  refreshPath();

  // 2. Buscar con where
  try {
    shell.Exec("where node").StdOut.ReadAll();
    return "node";
  } catch(e) {}

  // 3. Buscar en rutas tipicas de instalacion
  var candidatePaths = [
    shell.ExpandEnvironmentStrings("%ProgramFiles%\\nodejs\\node.exe"),
    shell.ExpandEnvironmentStrings("%ProgramW6432%\\nodejs\\node.exe"),
    shell.ExpandEnvironmentStrings("%LocalAppData%\\Programs\\nodejs\\node.exe"),
    shell.ExpandEnvironmentStrings("%AppData%\\Programs\\nodejs\\node.exe"),
    "C:\\Program Files\\nodejs\\node.exe",
    "C:\\Program Files (x86)\\nodejs\\node.exe"
  ];

  for (var i = 0; i < candidatePaths.length; i++) {
    if (fso.FileExists(candidatePaths[i])) {
      // Agregar al PATH
      var folder = candidatePaths[i].substring(0, candidatePaths[i].lastIndexOf("\\"));
      try {
        var env = shell.Environment("Process");
        env("PATH") = folder + ";" + env("PATH");
      } catch(e) {}
      return candidatePaths[i];
    }
  }

  return null;
}

function getNodeVersion(nodeExe) {
  try {
    var cmd = nodeExe.indexOf(" ") > -1 ? ('"' + nodeExe + '" -v') : (nodeExe + " -v");
    return shell.Exec(cmd).StdOut.ReadAll().trim();
  } catch(e) {
    return "desconocida";
  }
}

function findBun() {
  try {
    shell.Exec("where bun").StdOut.ReadAll();
    return true;
  } catch(e) {
    return false;
  }
}

function getPkgExec(prefix) {
  return findBun() ? ("bunx " + prefix) : ("npx " + prefix);
}

// ============================================================
// UTILIDADES
// ============================================================
function log(msg, type) {
  var box = document.getElementById("logBox");
  var line = document.createElement("p");
  line.className = "log-line " + (type || "info");
  line.innerText = msg;
  box.appendChild(line);
  box.scrollTop = box.scrollHeight;
}

function setProgress(step, total) {
  var pct = Math.round((step / total) * 100);
  document.getElementById("stepLabel").innerText = "Paso " + step + " / " + total;
  document.getElementById("pctLabel").innerText = pct + "%";
  document.getElementById("progressFill").style.width = pct + "%";
}

function runCmd(cmd) {
  try {
    return shell.Run(cmd, 0, true);
  } catch(e) {
    return -1;
  }
}

function fileExists(p) { return fso.FileExists(p); }
function folderExists(p) { return fso.FolderExists(p); }
function deleteFolder(p) { try { if (folderExists(p)) fso.DeleteFolder(p, true); } catch(e) {} }
function deleteFile(p) { try { if (fileExists(p)) fso.DeleteFile(p, true); } catch(e) {} }

function sleep(ms) {
  var d = new Date();
  while (new Date() - d < ms) {}
}

// ============================================================
// INSTALACION
// ============================================================
function startInstall() {
  document.getElementById("btnInstall").disabled = true;
  document.getElementById("btnInstall").innerText = "Instalando...";

  // Paso 1: Cerrar procesos
  currentStep = 1;
  setProgress(currentStep, totalSteps);
  log("[1/7] Cerrando procesos Node.js anteriores...", "step");
  shell.Run("taskkill /F /IM node.exe", 0, true);
  sleep(2000);
  log("  Procesos cerrados", "ok");

  // Paso 2: Limpieza
  currentStep = 2;
  setProgress(currentStep, totalSteps);
  log("[2/7] Limpiando instalacion anterior...", "step");
  deleteFolder(scriptDir + "\\node_modules");
  deleteFolder(scriptDir + "\\.next");
  deleteFile(scriptDir + "\\package-lock.json");
  deleteFile(scriptDir + "\\prisma\\dev.db");
  deleteFile(scriptDir + "\\prisma\\dev.db-journal");
  deleteFile(scriptDir + "\\prisma\\dev.db-wal");
  deleteFile(scriptDir + "\\prisma\\dev.db-shm");
  deleteFile(scriptDir + "\\.env");
  deleteFile(scriptDir + "\\.prisma");
  log("  Archivos limpiados correctamente", "ok");

  // Paso 3: Verificar Node.js (CON PATH REFRESH)
  currentStep = 3;
  setProgress(currentStep, totalSteps);
  log("[3/7] Verificando requisitos del sistema...", "step");

  // Re-buscar Node.js con PATH refrescado
  nodePath = findNodeJS();
  if (!nodePath) {
    log("");
    log("  ============================================", "error");
    log("  ERROR: Node.js NO encontrado.", "error");
    log("", "error");
    log("  Si ya instalo Node.js:", "warn");
    log("    1. Cierre ESTA ventana", "warn");
    log("    2. Cierre TODAS las ventanas de CMD", "warn");
    log("    3. O mejor: REINICIE su computadora", "warn");
    log("    4. Vuelva a abrir este HTA", "warn");
    log("", "error");
    log("  Descargue Node.js de: https://nodejs.org", "info");
    log("  ============================================", "error");
    document.getElementById("btnInstall").disabled = false;
    document.getElementById("btnInstall").innerText = "Reintentar";
    return;
  }

  var nodeVer = getNodeVersion(nodePath);
  log("  Node.js: " + nodeVer + " — OK", "ok");

  // Detectar gestor de paquetes
  var hasBun = findBun();
  var pkgManager = hasBun ? "bun" : "npm";
  var pkgInstall = hasBun ? "bun install" : "npm install --legacy-peer-deps";
  log("  Gestor de paquetes: " + pkgManager, "info");

  // Paso 4: Instalar dependencias
  currentStep = 4;
  setProgress(currentStep, totalSteps);
  log("[4/7] Instalando dependencias (esto puede tardar)...", "step");
  var ret = runCmd('cmd /c cd /d "' + scriptDir + '" && ' + pkgInstall);
  if (ret !== 0) {
    log("  Primer intento fallo, reintentando con --force...", "warn");
    deleteFolder(scriptDir + "\\node_modules");
    runCmd('cmd /c cd /d "' + scriptDir + '" && npm install --legacy-peer-deps --force');
  }
  log("  Dependencias instaladas", "ok");

  // Paso 5: Prisma
  currentStep = 5;
  setProgress(currentStep, totalSteps);
  log("[5/7] Generando Prisma y base de datos...", "step");
  runCmd('cmd /c cd /d "' + scriptDir + '" && ' + getPkgExec("prisma generate"));
  log("  Cliente Prisma generado", "ok");
  runCmd('cmd /c cd /d "' + scriptDir + '" && ' + getPkgExec("prisma db push"));
  log("  Base de datos SQLite creada", "ok");

  // Paso 6: Config .env
  currentStep = 6;
  setProgress(currentStep, totalSteps);
  log("[6/7] Configurando variables de entorno...", "step");
  var envExample = scriptDir + "\\.env.example";
  var envFile = scriptDir + "\\.env";
  if (!fileExists(envFile) && fileExists(envExample)) {
    fso.CopyFile(envExample, envFile);
    log("  .env creado desde .env.example", "ok");
  } else if (!fileExists(envFile)) {
    var tf = fso.CreateTextFile(envFile, true);
    tf.WriteLine('DATABASE_URL="file:./dev.db"');
    tf.WriteLine("APP_PORT=3000");
    tf.WriteLine("NODE_ENV=production");
    tf.Close();
    log("  .env creado con valores por defecto", "ok");
  } else {
    log("  .env ya existe, no se modifica", "warn");
  }

  var respDir = scriptDir + "\\respaldos";
  if (!folderExists(respDir)) fso.CreateFolder(respDir);
  log("  Carpeta respaldos creada", "ok");

  // Paso 7: Compilar
  currentStep = 7;
  setProgress(currentStep, totalSteps);
  log("[7/7] Compilando para produccion...", "step");
  var buildCmd = hasBun ? "bun run build" : "npm run build";
  runCmd('cmd /c cd /d "' + scriptDir + '" && ' + buildCmd);
  log("  Compilacion completada", "ok");

  // Completado
  setProgress(totalSteps, totalSteps);
  log("", "info");
  log("=== INSTALACION COMPLETADA ===", "step");
  log("", "info");
  log("Para iniciar: INICIAR-TODO.bat", "ok");
  log("Navegador: http://localhost:3000", "ok");
  log("Usuario: admin / admin", "ok");

  // Crear acceso directo
  try {
    var desktop = shell.SpecialFolders("Desktop");
    var lnk = shell.CreateShortcut(desktop + "\\Nexus One POS.lnk");
    lnk.TargetPath = scriptDir + "\\INICIAR-TODO.bat";
    lnk.WorkingDirectory = scriptDir;
    lnk.Description = "Nexus One POS v2.9.73";
    lnk.IconLocation = "shell32.dll,14";
    lnk.Save();
    log("Acceso directo creado en el Escritorio", "ok");
  } catch(e) {
    log("No se pudo crear acceso directo", "warn");
  }

  // UI final
  document.getElementById("successBanner").style.display = "block";
  document.getElementById("btnInstall").style.display = "none";
  document.getElementById("btnClose").style.display = "inline-block";
}

window.onload = init;
</script>
</body>
</html>
