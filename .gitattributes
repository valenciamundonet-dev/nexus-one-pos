# Line endings automaticos para todo (regla general)
* text=auto eol=lf

# Windows script files: almacenar bytes exactos (CRLF requerido)
# Estas reglas SOBREESCRIBEN la regla general '*' de arriba
# El atributo '-text' desactiva toda normalizacion de lineas
*.bat -text
*.cmd -text
*.vbs -text
*.hta -text

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.db-wal binary
*.db-shm binary
*.db-journal binary
*.exe binary
*.zip binary
*.pdf binary
